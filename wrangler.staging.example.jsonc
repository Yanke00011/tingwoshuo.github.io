{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tingwoshuo-blog-v7-staging",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "staging"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tingwoshuo-studio-v7-staging",
      "database_id": "REPLACE_WITH_STAGING_D1_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_MEDIA",
      "bucket_name": "tingwoshuo-v7-staging-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "REPLACE_WITH_STAGING_KV_ID"
    }
  ]
}
