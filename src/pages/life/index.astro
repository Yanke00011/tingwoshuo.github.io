---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/common/PostCard.astro';
import { Coffee } from '@lucide/astro';
import { getPosts, tagsOf } from '@/lib/posts';
const posts = await getPosts('life');
const tags = tagsOf(posts);
const active = Astro.url.searchParams.get('tag');
const filtered = active ? posts.filter((post) => post.data.tags.includes(active)) : posts;
const page = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const pageSize = 8;
const pageCount = Math.max(1, Math.ceil(filtered.length / pageSize));
const pagePosts = filtered.slice((page - 1) * pageSize, page * pageSize);
const pageHref = (number: number) => `/life?${active ? `tag=${encodeURIComponent(active)}&` : ''}page=${number}`;
---
<BaseLayout title="随便聊聊" description="生活、日常、见闻，以及偶尔冒出来的想法。">
  <section class="page-intro container">
    <div class="intro-icon"><Coffee size={20}/></div>
    <span class="eyebrow">LIFE NOTES · 日常记录</span>
    <h1>随便聊聊<span>。</span></h1>
    <p>生活不需要每一刻都很特别。<br/>偶尔停下来，把看见的、想到的，轻轻记下来。</p>
    <div class="intro-foot"><span>{posts.length} 篇随笔</span><span class="small-divider">·</span><span>慢慢写，不赶时间</span></div>
  </section>
  <section class="listing container">
    <div class="filter-row"><span>按标签看看</span><a class:list={{ selected: !active }} href="/life">全部</a>{tags.map((tag) => <a class:list={{ selected: active === tag }} href={`/life?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
    {pagePosts.length > 0 && <div class="page-results">
      <div class="post-grid">{pagePosts.map((post) => <PostCard post={post}/>)}</div>
      {pageCount > 1 && <nav class="pagination" aria-label="文章分页">
        {page > 1 ? <a href={pageHref(page - 1)}>← 更新的文章</a> : <span></span>}
        <span>第 {page} / {pageCount} 页</span>
        {page < pageCount ? <a href={pageHref(page + 1)}>更早的文章 →</a> : <span></span>}
      </nav>}
    </div>}
    {pagePosts.length === 0 && <div class="empty-state"><p>这里还没有文章。新的记录正在路上。</p></div>}
  </section>
</BaseLayout>
<style>.page-intro{padding:76px 0 50px;border-bottom:1px solid var(--line)}.intro-icon{width:48px;height:48px;border-radius:16px;background:#eee9dd;color:var(--accent-strong);display:grid;place-items:center;margin-bottom:25px}:root[data-theme="dark"] .intro-icon{background:#353329}.page-intro h1{font-size:clamp(3rem,7vw,5rem);line-height:1.12;letter-spacing:-.07em;margin:12px 0}.page-intro h1 span{color:var(--accent)}.page-intro p{color:var(--muted);font-size:1.05rem;line-height:1.85;margin:0}.intro-foot{display:flex;gap:10px;margin-top:24px;color:var(--muted);font-size:.78rem}.listing{padding-top:27px}.filter-row{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:25px;color:var(--muted);font-size:.78rem}.filter-row a{padding:5px 11px;border-radius:100px;background:var(--surface-soft);font-size:.74rem}.filter-row a.selected{background:var(--accent);color:white}.post-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.pagination{display:flex;align-items:center;justify-content:space-between;margin-top:26px;padding-top:17px;border-top:1px solid var(--line);font-size:.78rem}.pagination a{color:var(--accent-strong);font-weight:600}.pagination span{color:var(--muted)}.empty-state{text-align:center;padding:50px;color:var(--muted);border:1px dashed var(--line);border-radius:18px}@media(max-width:680px){.page-intro{padding:58px 0 34px}.post-grid{grid-template-columns:1fr}}</style>
