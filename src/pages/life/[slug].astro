---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPost } from '@/lib/content-db';
const post = await getPost(Astro.locals, 'life', Astro.params.slug ?? '');
if (!post) Astro.response.status = 404;
---
{post ? <ArticleLayout post={post} /> : <BaseLayout title="文章没有找到" description="这篇文章目前不可用。" noindex><section class="container page-intro"><h1>文章没有找到</h1><p>它可能已经撤回，或永久链接有误。</p><a class="text-link" href="/life">返回随便聊聊</a></section></BaseLayout>}
