---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { ArrowUpRight, Mail, GitBranch, Sparkles } from '@lucide/astro'; import { site } from '@/config/site';
---
<BaseLayout title="关于" description="认识听我说：一个记录生活、想法与技术的个人空间。"><section class="container about-page"><span class="eyebrow">A LITTLE ABOUT THIS SPACE</span><h1>你好，<br/>很高兴你来<span>。</span></h1><div class="about-grid"><div class="about-main"><p class="about-lead">这里是「听我说」，一个留给生活、想法和技术的小小角落。</p><p>我相信生活里那些细小的发现值得被记下，学习过程里的问题和答案也值得分享。这个网站会慢慢长大，内容由我亲自书写与整理。</p><div class="about-note"><Sparkles size={17}/><span>以下个人资料目前是可替换的示例位置，不代表真实身份或经历。</span></div><h2>关于作者</h2><div class="editable"><strong>{site.author}</strong><p>在这里写一段你的自我介绍：你是谁、最近在关注什么，以及为什么开始写这个博客。</p></div><h2>最近在做的事</h2><ul class="interest-list"><li><span>01</span><div><strong>持续学习</strong><p>填入你正在探索的技术方向或主题。</p></div></li><li><span>02</span><div><strong>认真生活</strong><p>填入你喜欢的爱好、电影、游戏或旅行。</p></div></li><li><span>03</span><div><strong>动手创造</strong><p>介绍你正在做的项目或想完成的小目标。</p></div></li></ul></div><aside class="about-aside"><div class="profile-card">{site.authorAvatar?<img class="avatar-placeholder" src={site.authorAvatar} alt={`${site.author}头像`} loading="lazy"/>:<div class="avatar-placeholder" aria-hidden="true">听</div>}<span class="eyebrow">THE PERSON BEHIND THE NOTES</span><strong>{site.author}</strong><p>一位愿意持续观察、学习与表达的人。</p><div class="profile-links">{site.github&&<a href={site.github} target="_blank" rel="noopener noreferrer"><GitBranch size={16}/>GitHub<ArrowUpRight size={13}/></a>}{site.email&&<a href={`mailto:${site.email}`}><Mail size={16}/>邮件联系<ArrowUpRight size={13}/></a>}{!site.github&&!site.email&&<span class="profile-empty">社交链接可在 src/config/site.ts 配置</span>}</div></div></aside></div></section></BaseLayout>
<style>.about-page{padding-top:76px}.about-page h1{font-size:clamp(3.2rem,7vw,5.6rem);line-height:1.12;letter-spacing:-.075em;margin:17px 0 62px}.about-page h1 span{color:var(--accent)}.about-grid{display:grid;grid-template-columns:minmax(0,700px) 280px;gap:70px;justify-content:space-between}.about-main{font-size:.98rem;color:var(--muted);line-height:1.9}.about-lead{font-size:1.35rem;line-height:1.65;color:var(--text);letter-spacing:-.025em}.about-main h2{font-size:1.3rem;color:var(--text);margin:46px 0 13px;letter-spacing:-.03em}.about-note{display:flex;gap:10px;align-items:flex-start;background:var(--accent-wash);border-radius:13px;padding:14px 16px;margin:26px 0;color:var(--accent-strong);font-size:.78rem;line-height:1.6}.about-note svg{flex:none;margin-top:2px}.editable{border-left:2px solid var(--accent);padding-left:16px}.editable strong{color:var(--text)}.editable p{margin:5px 0}.interest-list{list-style:none;padding:0;display:grid;gap:14px}.interest-list li{display:grid;grid-template-columns:40px 1fr;gap:12px}.interest-list li>span{font-size:.72rem;color:var(--accent);padding-top:3px}.interest-list strong{color:var(--text)}.interest-list p{font-size:.86rem;margin:1px 0}.profile-card{border:1px solid var(--line);background:var(--surface);padding:22px;border-radius:20px;display:flex;flex-direction:column;align-items:flex-start}.avatar-placeholder{width:76px;height:76px;object-fit:cover;background:var(--accent-wash);border-radius:26px;display:grid;place-items:center;font-size:2.2rem;color:var(--accent);font-weight:600;margin-bottom:22px}.profile-card .eyebrow{font-size:.57rem;line-height:1.7}.profile-card>strong{font-size:1.15rem;margin-top:8px}.profile-card>p{color:var(--muted);font-size:.83rem;margin:5px 0 15px}.profile-links{border-top:1px solid var(--line);padding-top:14px;width:100%;display:grid;gap:12px}.profile-links a{display:flex;align-items:center;gap:8px;font-size:.82rem}.profile-links a svg:last-child{margin-left:auto;color:var(--muted)}.profile-empty{font-size:.72rem;color:var(--muted)}@media(max-width:760px){.about-page{padding-top:55px}.about-page h1{margin-bottom:40px}.about-grid{grid-template-columns:1fr;gap:35px}.about-aside{order:-1}.profile-card{max-width:none}.avatar-placeholder{width:62px;height:62px;border-radius:21px;font-size:1.8rem}}</style>
