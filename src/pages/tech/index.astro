---
import BaseLayout from '@/layouts/BaseLayout.astro'; import PostCard from '@/components/common/PostCard.astro'; import { getPosts, tagsOf } from '@/lib/posts'; import { Braces } from '@lucide/astro';
const posts=await getPosts('tech');const tags=tagsOf(posts);const active=Astro.url.searchParams.get('tag');const filtered=active?posts.filter(p=>p.data.tags.includes(active)):posts;
---
<BaseLayout title="技术手记" description="开发经验、技术探索，以及那些折腾出来的小成果。"><section class="page-intro container"><div class="intro-icon"><Braces size={20}/></div><span class="eyebrow">TECH JOURNAL · 探索与记录</span><h1>技术手记<span>。</span></h1><p>把问题走过一遍，把经验写下来。<br/>关于代码、工具与每一次动手实践。</p><div class="intro-foot"><span>{posts.length} 篇文章</span><span class="small-divider">·</span><span>实践笔记与开发经验</span></div></section><section class="listing container"><div class="filter-row"><span>主题</span><a class:list={{selected:!active}} href="/tech">全部</a>{tags.map(tag=><a class:list={{selected:active===tag}} href={`/tech?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>{filtered.length?<div class="post-grid">{filtered.map(post=><PostCard post={post}/>)}</div>:<div class="empty-state"><p>这里还没有文章。第一篇技术手记很快会出现。</p></div>}</section></BaseLayout>
<style>.page-intro{padding:76px 0 50px;border-bottom:1px solid var(--line)}.intro-icon{width:48px;height:48px;border-radius:16px;background:var(--accent-wash);color:var(--accent-strong);display:grid;place-items:center;margin-bottom:25px}.page-intro h1{font-size:clamp(3rem,7vw,5rem);line-height:1.12;letter-spacing:-.07em;margin:12px 0}.page-intro h1 span{color:var(--accent)}.page-intro p{color:var(--muted);font-size:1.05rem;line-height:1.85;margin:0}.intro-foot{display:flex;gap:10px;margin-top:24px;color:var(--muted);font-size:.78rem}.listing{padding-top:27px}.filter-row{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:25px;color:var(--muted);font-size:.78rem}.filter-row a{padding:5px 11px;border-radius:100px;background:var(--surface-soft);font-size:.74rem}.filter-row a.selected{background:var(--accent);color:white}.post-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.empty-state{text-align:center;padding:50px;color:var(--muted);border:1px dashed var(--line);border-radius:18px}@media(max-width:680px){.page-intro{padding:58px 0 34px}.post-grid{grid-template-columns:1fr}}</style>
