---
import { getCollection, render } from 'astro:content'; import BaseLayout from '@/layouts/BaseLayout.astro'; import { getPosts, dateLabel, readingMinutes } from '@/lib/posts'; import { ArrowLeft, ArrowRight, Clock3 } from '@lucide/astro'; import { site } from '@/config/site'; import RelatedPosts from '@/components/article/RelatedPosts.astro';
export async function getStaticPaths(){const posts=await getCollection('tech',({data})=>!data.draft);return posts.map(post=>({params:{slug:post.id},props:{post}}))}
const {post}=Astro.props;const {Content,headings}=await render(post);const all=await getPosts('tech');const index=all.findIndex(p=>p.id===post.id);const previous=all[index+1],next=all[index-1];const minutes=readingMinutes(post.body);const structured={"@context":"https://schema.org","@type":"BlogPosting","headline":post.data.title,"description":post.data.description,"datePublished":post.data.pubDate.toISOString(),"dateModified":(post.data.updatedDate||post.data.pubDate).toISOString(),"mainEntityOfPage":new URL(`/tech/${post.id}`,Astro.site).toString(),"author":{"@type":"Person","name":site.author}};
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover||'/og.png'}><script type="application/ld+json" set:html={JSON.stringify(structured)}/><article class="article container" data-pagefind-body><span class="sr-only" data-pagefind-meta="section">技术</span><a href="/tech" class="back-link"><ArrowLeft size={15}/> 技术手记</a><header class="article-header"><span class="eyebrow">TECH JOURNAL · 技术记录</span><h1>{post.data.title}</h1><p class="article-deck">{post.data.description}</p><div class="article-meta"><time datetime={post.data.pubDate.toISOString()}>{dateLabel(post.data.pubDate)}</time>{post.data.updatedDate&&<span>更新于 {dateLabel(post.data.updatedDate)}</span>}<span><Clock3 size={14}/>{minutes} 分钟阅读</span></div><div class="article-tags">{post.data.tags.map(tag=><span class="tag">{tag}</span>)}</div>{post.data.cover && <figure class="article-cover"><img src={post.data.cover} alt={post.data.coverAlt || ""} loading="eager" fetchpriority="high"/><figcaption>{post.data.coverAlt}</figcaption></figure>}</header><div class="article-layout"><div class="prose"><Content/></div>{headings.length>2&&<aside class="toc"><strong>这一页</strong><nav>{headings.map(h=><a href={`#${h.slug}`} class:list={{sub:h.depth>2}}>{h.text}</a>)}</nav></aside>}</div><nav class="post-nav" aria-label="文章导航">{previous?<a href={`/tech/${previous.id}`}><span><ArrowLeft size={14}/>上一篇</span><strong>{previous.data.title}</strong></a>:<span></span>}{next?<a href={`/tech/${next.id}`} class="next"><span>下一篇 <ArrowRight size={14}/></span><strong>{next.data.title}</strong></a>:<span></span>}</nav><RelatedPosts current={post}/></article></BaseLayout>
<style>.article{padding-top:42px}.back-link{display:inline-flex;align-items:center;gap:8px;color:var(--muted);font-size:.82rem}.article-header{max-width:820px;margin:65px auto 52px;text-align:center}.article-header h1{font-size:clamp(2.4rem,5.2vw,4.1rem);line-height:1.25;letter-spacing:-.06em;margin:15px 0}.article-deck{max-width:660px;margin:0 auto;color:var(--muted);font-size:1.08rem;line-height:1.8}.article-meta{display:flex;justify-content:center;gap:17px;flex-wrap:wrap;color:var(--muted);font-size:.77rem;margin-top:24px}.article-meta span{display:flex;align-items:center;gap:5px}.article-tags{display:flex;gap:7px;justify-content:center;margin-top:18px}.article-cover{margin:28px 0 0}.article-cover img{width:100%;max-height:520px;object-fit:cover;border-radius:20px}.article-cover figcaption{font-size:.75rem;color:var(--muted);margin-top:8px}.article-layout{display:grid;grid-template-columns:minmax(0,var(--reading)) 210px;gap:65px;justify-content:center;align-items:start}.toc{position:sticky;top:105px;border-left:1px solid var(--line);padding-left:16px;font-size:.75rem}.toc strong{font-size:.76rem}.toc nav{display:grid;gap:8px;margin-top:11px}.toc a{color:var(--muted);line-height:1.5}.toc a:hover{color:var(--accent-strong)}.toc a.sub{padding-left:10px}.article-layout:has(.toc){grid-template-columns:minmax(0,var(--reading)) 210px}.post-nav{max-width:var(--reading);margin:72px auto 0;padding-top:22px;border-top:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr;gap:18px}.post-nav a{display:grid;gap:8px}.post-nav a.next{text-align:right}.post-nav span{font-size:.72rem;color:var(--muted);display:flex;align-items:center;gap:6px}.post-nav .next span{justify-content:end}.post-nav strong{font-size:.85rem;line-height:1.5}@media(max-width:950px){.article-layout,.article-layout:has(.toc){grid-template-columns:minmax(0,var(--reading));gap:25px}.toc{position:static;border:1px solid var(--line);border-radius:14px;padding:14px 16px;order:-1}.toc nav{grid-template-columns:repeat(2,1fr)}}@media(max-width:640px){.article{padding-top:27px}.article-header{margin:45px auto 36px}.article-header h1{font-size:2.35rem}.article-deck{font-size:.98rem}.article-meta{gap:10px}.toc nav{grid-template-columns:1fr 1fr}.post-nav{margin-top:50px;gap:10px}.post-nav strong{font-size:.75rem}}</style>
