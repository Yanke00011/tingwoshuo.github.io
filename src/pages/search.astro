---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Search } from '@lucide/astro';
---
<BaseLayout title="搜索" description="搜索听我说中的全部文章。">
  <section class="container search-page">
    <header class="page-intro">
      <h1>搜索文章</h1>
      <p>搜索生活记录与技术手记中的关键词。</p>
    </header>
    <label class="search-field">
      <Search size={18} />
      <span class="sr-only">搜索关键词</span>
      <input id="pagefind-search" type="search" placeholder="例如 TypeScript 或周末" />
    </label>
    <div class="filter-row" role="group" aria-label="按栏目筛选">
      <button type="button" data-category="" aria-pressed="true">全部</button>
      <button type="button" data-category="life" aria-pressed="false">闲聊</button>
      <button type="button" data-category="tech" aria-pressed="false">技术</button>
    </div>
    <p class="search-status" id="search-status" role="status">输入关键词开始搜索。</p>
    <div id="pagefind-results" class="search-results"></div>
  </section>
</BaseLayout>

<script>
  import { findArticles } from '@/lib/search-client';
  import { createHighlighter, renderExcerpt } from '@/lib/search-highlight';

  const input = document.querySelector<HTMLInputElement>('#pagefind-search')!;
  const status = document.querySelector('#search-status')!;
  const output = document.querySelector('#pagefind-results')!;
  let results: Awaited<ReturnType<typeof findArticles>> = [];
  let category = '';
  let request = 0;
  let hasSearched = false;

  function renderResults() {
    const filtered = results.filter((item) => !category || new URL(item.url, location.origin).pathname.startsWith(`/${category}/`));
    status.textContent = filtered.length ? `找到 ${filtered.length} 条结果` : '没有找到相关文章，试试其他关键词。';
    output.replaceChildren();
    const highlight = createHighlighter(input.value.trim());
    for (const item of filtered) {
      const link = document.createElement('a');
      link.href = item.url;
      const label = document.createElement('span');
      label.append(highlight(item.meta.section ?? ''));
      const title = document.createElement('h2');
      title.append(highlight(item.meta.title || '未命名文章'));
      const snippet = document.createElement('p');
      snippet.append(renderExcerpt(item.excerpt, highlight));
      link.append(label, title, snippet);
      output.append(link);
    }
  }

  input.addEventListener('input', async () => {
    const id = ++request;
    const query = input.value.trim();
    hasSearched = false;
    output.replaceChildren();
    status.textContent = query ? '正在搜索…' : '输入关键词开始搜索。';
    if (!query) return;
    try {
      const matches = await findArticles(query);
      if (id !== request) return;
      results = matches;
      hasSearched = true;
      renderResults();
    } catch {
      if (id === request) status.textContent = '搜索索引暂不可用，请使用构建后的预览。';
    }
  });
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-category]');
  for (const button of filters) {
    button.addEventListener('click', () => {
      category = button.dataset.category ?? '';
      for (const filter of filters) filter.setAttribute('aria-pressed', String(filter === button));
      if (hasSearched) renderResults();
    });
  }
</script>

<style>
  .search-page { max-width: 54rem; }
  .page-intro { margin-bottom: var(--space-20); }
  .search-field { min-height: 3.5rem; padding-inline: var(--space-16); }
  .filter-row { margin-top: var(--space-12); }
  .search-results { display: grid; gap: var(--space-8); }
  .search-results :global(a) {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    padding: var(--space-16) var(--space-20);
    background: var(--surface);
    overflow-wrap: anywhere;
    transition: border-color var(--duration) var(--ease), background-color var(--duration) var(--ease);
  }
  .search-results :global(a:hover) { border-color: var(--accent); background: var(--accent-wash); }
  .search-results :global(h2) { font-size: var(--type-subsection); line-height: var(--leading-heading); margin-top: var(--space-4); }
  .search-results :global(span) { color: var(--accent-strong); font-size: var(--type-meta); }
  .search-results :global(p) { margin-top: var(--space-8); color: var(--secondary); font-size: var(--type-small); }
</style>
