---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';
---
<BaseLayout title="页面没有找到" description="这个页面暂时没有在这里。" noindex>
  <section class="container not-found">
    <div class="detour-copy">
    <p class="number" aria-hidden="true">404</p>
    <h1>页面没有找到</h1>
    <p>也许链接已经换了位置，或者它还没有被写下来。</p>
    <div class="actions">
      <a class="primary-button" href="/"><ArrowLeft size={16} /> 回到首页</a>
      <a class="text-link" href="/archive">查看归档 <ArrowUpRight size={16} /></a>
    </div>
    </div>
    <img src="/brand/signal-plate.svg" width="680" height="410" alt="" />
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    margin-top: var(--space-24);
    padding: clamp(1.25rem, 5vw, 4rem);
    border-radius: var(--radius-feature);
    color: var(--ink-text);
    background: radial-gradient(ellipse at right, #49325c, var(--ink) 80%);
  }
  .not-found .primary-button { background: var(--signal); color: var(--ink); }
  .not-found .text-link { color: var(--ink-text); }
  .not-found :is(a, button):focus-visible { outline-color: var(--signal); }
  .not-found img { height: auto; }
  @media (width < 48rem) { .not-found { grid-template-columns: minmax(0, 1fr); } }
  .number { color: var(--signal); font-size: clamp(5rem, 18vw, 10rem); font-weight: 500; line-height: 1; font-variant-numeric: tabular-nums; }
  h1 { font-size: var(--type-title); margin-top: var(--space-16); }
  h1 + p { color: var(--ink-muted); margin-top: var(--space-8); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-8) var(--space-24); margin-top: var(--space-24); }
</style>
