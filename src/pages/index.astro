---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/common/PostCard.astro';
import { getPosts } from '@/lib/posts';
import { ArrowDown, ArrowUpRight, Sparkles, Coffee, Braces } from '@lucide/astro';
const posts = await getPosts();
const featured = posts.filter((post) => post.data.featured).slice(0, 1);
const latest = posts.filter((post) => !post.data.featured).slice(0, 4);
---
<BaseLayout title="生活值得记录，想法值得表达" description="关于生活、技术，以及那些值得记录的瞬间。听我说，一个安静的个人数字空间。">
  <section class="hero container fade-in"><div class="hero-copy"><span class="eyebrow"><span class="online-dot"></span> 一处慢慢更新的个人空间</span><h1>你好，<br/><span>欢迎听我说。</span></h1><p class="hero-sub">关于生活、技术，<br class="mobile-break"/>以及那些值得记录的瞬间。</p><div class="hero-actions"><a href="#corners" class="button-primary">从这里开始 <ArrowDown size={16}/></a><a href="/about" class="button-quiet">认识一下 <ArrowUpRight size={15}/></a></div></div><div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="art-note note-one">今天也有<br/>一点新发现。</div><div class="art-note note-two"><span>✳</span> take it slow</div><div class="art-center"><span>听</span><i></i><small>LISTEN · THINK · SHARE</small></div><div class="art-spark spark-a">✦</div><div class="art-spark spark-b">·</div></div><div class="hero-index"><span>01 — 记录日常</span><span>02 — 分享所学</span><span>03 — 保持好奇</span></div></section>
  <section class="intro container"><div class="intro-mark"><img src="/brand/mark.svg" alt="" width="48" height="48"/></div><div><span class="eyebrow">A NOTE FROM ZHANG</span><h2>你好，我是小张。</h2><p>喜欢 Apple 生态、macOS 与 Web 开发、人工智能、软硬件探索和游戏。这里记录我正在学习、制作和思考的事。</p><a href="/about" class="text-link">更多关于我 <ArrowUpRight size={15}/></a></div><div class="intro-projects"><span><b>PixelTime</b><small>macOS 时间工具</small></span><span><b>JIUJU</b><small>酒局记录与管理</small></span></div></section>
  <section class="corners container" id="corners"><div class="section-heading"><div><span class="eyebrow">TWO LITTLE CORNERS</span><h2>想说的话，都有地方。</h2></div><p>生活和技术，都是我想认真记录的事。</p></div><div class="corner-grid"><a class="corner-card life-corner" href="/life"><div class="corner-icon"><Coffee size={20}/></div><span class="eyebrow">LIFE NOTES · 日常</span><h3>随便聊聊</h3><p>记录生活、日常、见闻，以及偶尔冒出来的想法。</p><span class="corner-go">去逛逛 <ArrowUpRight size={16}/></span><span class="corner-decoration">☼</span></a><a class="corner-card tech-corner" href="/tech"><div class="corner-icon"><Braces size={20}/></div><span class="eyebrow">TECH JOURNAL · 技术</span><h3>技术手记</h3><p>分享开发经验、技术探索，以及那些折腾出来的小成果。</p><span class="corner-go">去看看 <ArrowUpRight size={16}/></span><span class="corner-decoration">⌘</span></a></div></section>
  {featured.length > 0 && <section class="featured container"><div class="section-heading"><div><span class="eyebrow">A NOTE TO KEEP</span><h2>值得再读一遍</h2></div></div>{featured.map((post)=><a href={`/${post.collection}/${post.id}`} class="featured-card"><div><span class="featured-label"><Sparkles size={14}/> 精选文章</span><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="featured-link">读一读 <ArrowUpRight size={16}/></span></div><div class="featured-number">01</div></a>)}</section>}
  <section class="latest container"><div class="section-heading"><div><span class="eyebrow">RECENTLY WRITTEN</span><h2>最近写下的</h2></div><a class="text-link" href="/archive">所有文章 <ArrowUpRight size={16}/></a></div>{latest.length ? <div class="post-grid">{latest.map((post)=><PostCard post={post}/>)}</div> : <p class="empty-state">新文章正在路上，稍后再来看看。</p>}</section>
  <section class="closing container"><div class="closing-inner"><span class="eyebrow">THANK YOU FOR BEING HERE</span><p>慢一点也没关系，<br/><strong>重要的是继续观察，继续表达。</strong></p><a href="/about" class="text-link">关于这个小小空间 <ArrowUpRight size={16}/></a><i class="closing-star">✳</i></div></section>
</BaseLayout>
<style>.hero{min-height:560px;position:relative;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;padding:76px 0 94px}.hero-copy{position:relative;z-index:2}.online-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#8eaa8d;margin-right:8px;box-shadow:0 0 0 4px color-mix(in srgb,#8eaa8d 16%,transparent)}.hero h1{font-size:clamp(3.3rem,7.1vw,6.1rem);line-height:1.13;letter-spacing:-.075em;margin:28px 0 20px;font-weight:700}.hero h1 span{color:var(--accent)}.hero-sub{font-size:1.12rem;color:var(--muted);line-height:1.85;margin:0}.mobile-break{display:none}.hero-actions{display:flex;align-items:center;gap:20px;margin-top:31px}.button-primary{display:inline-flex;align-items:center;gap:10px;padding:12px 18px;border-radius:100px;background:var(--accent);color:#fff;font-weight:600;font-size:.9rem;transition:transform .2s,background .2s}.button-primary:hover{background:var(--accent-strong);transform:translateY(-2px)}.button-quiet{display:inline-flex;align-items:center;gap:6px;color:var(--muted);font-size:.88rem}.hero-art{height:430px;position:relative;display:grid;place-items:center}.orbit{position:absolute;border:1px solid var(--line);border-radius:50%;transform:rotate(-22deg)}.orbit-one{width:350px;height:215px}.orbit-two{width:270px;height:335px;transform:rotate(50deg)}.orbit-three{width:410px;height:300px;transform:rotate(20deg);border-style:dashed;opacity:.7}.art-center{width:184px;height:184px;border-radius:52% 48% 45% 55%/52% 43% 57% 48%;background:var(--accent-wash);display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;transform:rotate(-8deg);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--accent) 10%,transparent)}.art-center span{font-size:4.8rem;line-height:1;color:var(--accent);font-weight:600;transform:rotate(8deg)}.art-center i{position:absolute;width:12px;height:12px;background:var(--warm);border-radius:50%;right:30px;top:30px}.art-center small{font-size:.48rem;letter-spacing:.18em;color:var(--muted);margin-top:12px;transform:rotate(8deg)}.art-note{position:absolute;padding:13px 17px;background:var(--glass);backdrop-filter:blur(12px);border:1px solid var(--line);border-radius:13px;box-shadow:var(--shadow);font-size:.76rem;color:var(--muted);line-height:1.55}.note-one{top:65px;right:0;transform:rotate(5deg)}.note-two{bottom:64px;left:4px;transform:rotate(-5deg)}.note-two span{color:var(--accent);margin-right:5px}.art-spark{position:absolute;color:var(--accent);font-size:1.4rem}.spark-a{top:78px;left:68px}.spark-b{bottom:96px;right:70px;font-size:2rem}.hero-index{position:absolute;left:0;bottom:34px;display:flex;gap:30px;color:var(--muted);font-size:.69rem;letter-spacing:.04em}.intro{display:grid;grid-template-columns:56px minmax(0,1fr) auto;gap:20px;align-items:start;padding:26px 28px;margin-top:4px;border:1px solid var(--line);border-radius:20px;background:var(--surface)}.intro h2{font-size:1.18rem;margin:5px 0;letter-spacing:-.03em}.intro p{font-size:.88rem;color:var(--muted);max-width:620px;margin:0 0 10px}.intro-mark img{display:block;border-radius:15px}.intro-projects{display:flex;gap:10px;padding-top:7px}.intro-projects span{display:grid;padding:10px 12px;border-left:1px solid var(--line)}.intro-projects b{font-size:.78rem}.intro-projects small{font-size:.68rem;color:var(--muted)}.corners,.latest,.featured{padding-top:65px}.section-heading p{max-width:280px;color:var(--muted);font-size:.85rem;margin:0 0 3px}.corner-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.corner-card{min-height:296px;padding:30px;border-radius:24px;position:relative;overflow:hidden;transition:transform .25s var(--ease),box-shadow .25s}.corner-card:hover{transform:translateY(-4px);box-shadow:var(--shadow)}.life-corner{background:#eee9dd}.tech-corner{background:#e6ece7}.corner-icon{width:42px;height:42px;border-radius:14px;background:rgba(255,255,255,.55);display:grid;place-items:center;color:var(--accent-strong);margin-bottom:25px}.corner-card .eyebrow{font-size:.63rem}.corner-card h3{font-size:1.85rem;letter-spacing:-.045em;margin:9px 0 5px}.corner-card p{font-size:.88rem;color:#6f736e;max-width:310px;margin:0;line-height:1.7}.corner-go{display:inline-flex;align-items:center;gap:7px;position:absolute;left:30px;bottom:26px;font-size:.82rem;font-weight:650;color:var(--accent-strong)}.corner-decoration{position:absolute;right:24px;top:13px;font-size:7rem;line-height:1;color:rgba(96,117,99,.1);font-weight:300}.tech-corner .corner-decoration{font-size:6rem;right:34px;top:26px}:root[data-theme="dark"] .life-corner{background:#353329}:root[data-theme="dark"] .tech-corner{background:#29342d}:root[data-theme="dark"] .corner-card p{color:var(--muted)}.post-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.featured-card{min-height:230px;border-radius:22px;background:var(--surface-soft);padding:30px 34px;display:flex;justify-content:space-between;position:relative;overflow:hidden}.featured-card h3{font-size:1.6rem;letter-spacing:-.04em;margin:18px 0 7px}.featured-card p{max-width:540px;color:var(--muted);font-size:.9rem;margin:0}.featured-label,.featured-link{display:inline-flex;align-items:center;gap:7px;color:var(--accent-strong);font-weight:650;font-size:.78rem}.featured-link{margin-top:20px}.featured-number{font-size:8rem;font-weight:700;letter-spacing:-.1em;color:color-mix(in srgb,var(--accent) 15%,transparent);align-self:center;line-height:1}.empty-state{padding:30px;border:1px dashed var(--line);border-radius:18px;color:var(--muted);text-align:center}.closing{padding-top:100px}.closing-inner{min-height:240px;background:var(--surface-soft);border-radius:24px;padding:38px 44px;position:relative;overflow:hidden}.closing-inner p{font-size:1.3rem;line-height:1.65;color:var(--muted);margin:17px 0}.closing-inner p strong{color:var(--text);font-weight:600}.closing-star{position:absolute;right:68px;top:28px;font-size:8rem;color:color-mix(in srgb,var(--accent) 17%,transparent);font-style:normal}@media(max-width:760px){.hero{min-height:0;grid-template-columns:1fr;padding:67px 0 110px}.hero h1{font-size:clamp(3.25rem,13vw,5rem);margin-top:22px}.hero-sub{font-size:1rem}.mobile-break{display:block}.hero-art{height:300px;margin:6px 0 0}.orbit-one{width:290px;height:180px}.orbit-two{width:225px;height:270px}.orbit-three{width:330px;height:240px}.art-center{width:145px;height:145px}.art-center span{font-size:3.7rem}.note-one{right:0;top:27px}.note-two{left:0;bottom:35px}.hero-index{bottom:31px;gap:14px;font-size:.59rem}.intro{grid-template-columns:44px minmax(0,1fr);padding:20px;gap:15px}.intro-mark img{width:42px;height:42px}.intro-projects{grid-column:2;padding:0}.corners,.latest,.featured{padding-top:48px}.section-heading p{display:none}.corner-grid{grid-template-columns:1fr}.corner-card{min-height:270px}.post-grid{grid-template-columns:1fr}.featured-card{padding:24px;min-height:220px}.featured-number{font-size:5rem;position:absolute;right:22px;bottom:4px}.closing{padding-top:70px}.closing-inner{padding:30px 25px}.closing-star{right:15px;top:3px;font-size:6rem;opacity:.6}}@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){}}
</style>
