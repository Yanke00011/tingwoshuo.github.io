---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/common/PostCard.astro';
import { getPosts } from '@/lib/posts';
import { ArrowDown, ArrowUpRight, AudioLines, Braces, Feather } from '@lucide/astro';

const posts = await getPosts(Astro.locals);
const featured = posts.find((post) => post.data.featured);
const latest = posts.filter((post) => !post.data.featured).slice(0, 4);
---
<BaseLayout title="生活值得记录，想法值得表达" description="关于生活、技术，以及那些值得记录的瞬间。听我说，一个安静的个人数字空间。">
  <div class="container home">
    <section class="cover">
      <div class="cover-copy">
        <p class="cover-label"><AudioLines size={16} aria-hidden="true" /> Hear Me Out · 小张的个人博客</p>
        <h1>听我说<span>。</span></h1>
        <p class="cover-deck">记下日常，也写下动手做东西的过程。</p>
        <div class="hero-actions">
          <a href="#latest" class="primary-button">读最新文章 <ArrowDown size={16} /></a>
          <a href="/about" class="text-link">关于我 <ArrowUpRight size={16} /></a>
        </div>
      </div>
      <figure class="cover-art" aria-hidden="true">
        <img src="/brand/signal-plate.svg" width="680" height="410" alt="" fetchpriority="high" />
      </figure>
    </section>

    <section class="corners" id="corners" aria-label="文章栏目" data-reveal>
      <a class="corner life" href="/life">
        <Feather class="corner-icon" size={22} aria-hidden="true" />
        <div><h2>随便聊聊</h2><p>记录生活、见闻和偶尔冒出来的想法。</p></div>
        <ArrowUpRight class="corner-arrow" size={20} aria-hidden="true" />
      </a>
      <a class="corner tech" href="/tech">
        <Braces class="corner-icon" size={22} aria-hidden="true" />
        <div><h2>技术手记</h2><p>分享开发经验、技术探索和动手做出来的小成果。</p></div>
        <ArrowUpRight class="corner-arrow" size={20} aria-hidden="true" />
      </a>
    </section>

    {featured && (
      <section class="home-section" data-reveal>
        <div class="section-heading"><h2>精选文章</h2></div>
        <PostCard post={featured} treatment="spotlight" />
      </section>
    )}

    <section class="home-section" id="latest" data-reveal>
      <div class="section-heading">
        <h2>最近写下的</h2>
        <a class="text-link" href="/archive">所有文章 <ArrowUpRight size={16} /></a>
      </div>
      {latest.length ? (
        <div class:list={['home-posts', { 'has-rail': latest.length > 1 }]}>
          {latest.map((post, index) => <PostCard post={post} treatment={index === 0 ? 'lead' : undefined} />)}
        </div>
      ) : <p class="empty-state">新文章正在路上，稍后再来看看。</p>}
    </section>

    <section class="home-section author" data-reveal>
      <img src="/brand/mark.svg" alt="" width="52" height="52" />
      <div>
        <h2>我是小张</h2>
        <p>喜欢 Apple 生态、macOS 与 Web 开发、人工智能、软硬件探索和游戏。这里记录我正在学习、制作和思考的事。</p>
        <a href="/about" class="text-link">更多关于我 <ArrowUpRight size={16} /></a>
      </div>
      <dl>
        <div><dt>PixelTime</dt><dd>macOS 时间工具</dd></div>
        <div><dt>JIUJU</dt><dd>酒局记录与管理</dd></div>
      </dl>
    </section>
  </div>
</BaseLayout>

<style>
  .home { padding-top: var(--space-24); }
  .cover {
    display: grid;
    grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr);
    align-items: center;
    background: radial-gradient(ellipse at 82% 38%, #49325c 0%, var(--ink) 66%);
    color: var(--ink-text);
    border-radius: var(--radius-feature);
    padding: clamp(1.375rem, 4.6vw, 4rem);
    overflow: hidden;
    isolation: isolate;
  }
  .cover-copy { position: relative; z-index: 1; }
  .cover-label { display: flex; align-items: center; gap: var(--space-8); color: var(--ink-muted); font-size: var(--type-meta); }
  .cover-label svg { color: var(--signal); flex-shrink: 0; }
  .cover h1 { font-size: clamp(3.2rem, 8.1vw, 7rem); line-height: 1.12; letter-spacing: -.085em; margin: var(--space-16) 0; font-weight: 750; }
  .cover h1 span { color: var(--signal); }
  .cover-deck { color: var(--ink-muted); font-size: var(--type-lead); max-width: 24rem; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-8) var(--space-20); margin-top: var(--space-24); }
  .cover .primary-button { background: var(--signal); color: var(--ink); }
  .cover .text-link { color: var(--ink-text); }
  .cover :is(a, button):focus-visible { outline-color: var(--signal); }
  .cover-art { margin: 0; min-width: 0; }
  .cover-art img { display: block; width: 100%; height: auto; }
  .corners { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); margin-top: var(--space-12); }
  .corner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-12);
    padding: var(--space-20);
    border-radius: var(--radius-panel);
    background: var(--life-wash);
    color: var(--life-ink);
  }
  .corner.tech { background: var(--accent-wash); color: var(--accent-strong); }
  .corner h2 { font-size: var(--type-subsection); line-height: var(--leading-heading); }
  .corner p { color: var(--secondary); font-size: var(--type-small); margin-top: var(--space-4); }
  .corner-icon, .corner-arrow { margin-top: var(--space-4); }
  .home-section { margin-top: var(--space-section); }
  .home-posts { display: grid; gap: var(--space-12) var(--space-24); margin-top: var(--space-16); }
  .author {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(9rem, .35fr);
    gap: var(--space-16) var(--space-24);
    background: var(--surface-soft);
    border-radius: var(--radius-feature);
    padding: clamp(1.25rem, 4vw, 3rem);
  }
  .author h2 { font-size: var(--type-section); }
  .author p { max-width: 38rem; color: var(--secondary); margin-top: var(--space-8); }
  .author dl { display: grid; gap: var(--space-12); align-content: start; }
  .author dt { font-weight: 650; }
  .author dd { color: var(--muted); font-size: var(--type-small); }
  @media (min-width: 48rem) {
    .home-posts.has-rail { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
    .home-posts.has-rail > :first-child { grid-row: 1 / span 3; }
  }
  @media (width < 48rem) {
    .home { padding-top: var(--space-12); }
    .cover, .corners { grid-template-columns: minmax(0, 1fr); }
    .cover-art { margin: var(--space-12) calc(-1 * var(--space-12)) calc(-1 * var(--space-12)); }
    .corner { padding: var(--space-16); }
    .author { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cover-copy { animation: cover-in 620ms var(--ease) both; }
    .cover-art { animation: cover-in 860ms 80ms var(--ease) both, signal-drift 7s 1s ease-in-out alternate 2; }
    .corner { transition: transform var(--duration) var(--ease), box-shadow var(--duration) var(--ease); }
    .corner:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
    @keyframes cover-in { from { opacity: 0; transform: translateY(12px); } }
    @keyframes signal-drift { to { transform: translate(4px, -5px) rotate(-.6deg); } }
  }
</style>
