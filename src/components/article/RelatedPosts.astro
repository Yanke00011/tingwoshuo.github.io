---
import PostCard from '@/components/common/PostCard.astro';
import type { Post } from '@/lib/posts';
import { getPosts } from '@/lib/posts';
const { current } = Astro.props as { current: Post };
const posts = await getPosts();
const related = posts.filter((post) => post.id !== current.id || post.collection !== current.collection)
  .map((post) => ({ post, score: post.data.tags.filter((tag) => current.data.tags.includes(tag)).length + (post.collection === current.collection ? 1 : 0) }))
  .filter((item) => item.score > 0).sort((a, b) => b.score - a.score).slice(0, 2).map((item) => item.post);
---
{related.length > 0 && (
  <section class="related" data-pagefind-ignore>
    <div class="section-heading"><h2>也许你还想读</h2></div>
    <div class="post-list">{related.map((post) => <PostCard post={post} compact />)}</div>
  </section>
)}
<style>
  .related { margin-top: var(--space-40); }
  .section-heading h2 { font-size: var(--type-subsection); }
</style>
