---
import { ArrowUpRight, Mail, Rss, ArrowUp } from '@lucide/astro';
import { site } from '@/config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer"><div class="container footer-inner"><div class="footer-copy"><a href="/" class="footer-brand">听我说<span> · HEAR ME OUT</span></a><p>生活值得记录，想法值得表达，技术值得分享。</p></div><div class="footer-links"><a href="/rss.xml"><Rss size={15}/> RSS</a>{site.github && <a href={site.github} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">⌘</span> GitHub <ArrowUpRight size={12}/></a>}{site.email && <a href={`mailto:${site.email}`}><Mail size={15}/> 邮件</a>}<a href="#top" class="back-top">回到顶部 <ArrowUp size={14}/></a></div><small class="copyright">© {site.copyrightStart}{year > site.copyrightStart ? `–${year}` : ''} {site.author}. 用心写下，慢慢分享。</small></div></footer>
<style>.site-footer{margin-top:110px;padding:40px 0 calc(28px + env(safe-area-inset-bottom));border-top:1px solid var(--line)}.footer-inner{display:grid;grid-template-columns:1fr auto;gap:28px;align-items:end}.footer-brand{font-weight:700;letter-spacing:.02em}.footer-brand span{font-size:.65rem;letter-spacing:.14em;color:var(--muted);font-weight:500}.footer-copy p{font-size:.82rem;color:var(--muted);margin:5px 0 0}.footer-links{display:flex;align-items:center;gap:20px}.footer-links a{display:flex;align-items:center;gap:6px;font-size:.8rem;color:var(--muted)}.footer-links a:hover{color:var(--accent-strong)}.copyright{grid-column:1/-1;color:var(--muted);font-size:.72rem}.back-top{margin-left:12px}@media(max-width:640px){.site-footer{margin-top:76px}.footer-inner{grid-template-columns:1fr;align-items:start;gap:20px}.footer-links{flex-wrap:wrap;gap:16px}.copyright{grid-column:auto}}</style>
