---
import { ArrowUpRight, Mail, Rss, ArrowUp } from '@lucide/astro';
import { site } from '@/config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer" data-pagefind-ignore>
  <div class="container footer-inner">
    <div class="footer-identity">
      <a class="footer-brand" href="/"><span class="footer-mark" aria-hidden="true"></span> 听我说</a>
      <small class="copyright">© {year} {site.copyrightName} · {site.copyrightEnglishName}</small>
    </div>
    <nav class="footer-links" aria-label="页脚">
      <a href="/rss.xml"><Rss size={16} /> RSS</a>
      {site.github && <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <ArrowUpRight size={16} /></a>}
      {site.email && <a href={`mailto:${site.email}`}><Mail size={16} /> 邮件</a>}
      <a href="#top">回到顶部 <ArrowUp size={16} /></a>
    </nav>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--space-section); padding-block: var(--space-32) calc(var(--space-32) + env(safe-area-inset-bottom)); background: var(--ink); color: var(--ink-text); }
  .footer-inner, .footer-links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-8) var(--space-24); }
  .footer-inner { justify-content: space-between; }
  .footer-identity { display: grid; gap: var(--space-8); }
  .footer-brand { display: flex; align-items: center; gap: var(--space-8); width: fit-content; min-height: var(--target); font-weight: 650; }
  .footer-mark { width: 2rem; height: 2rem; background: url("/brand/mark.svg") center / contain no-repeat; }
  .site-footer a:focus-visible { outline-color: var(--signal); }
  .copyright, .footer-links a { color: var(--ink-muted); font-size: var(--type-meta); }
  .footer-links a { display: inline-flex; align-items: center; gap: var(--space-8); min-height: var(--target); }
  .footer-links a:hover { color: var(--signal); }
</style>
