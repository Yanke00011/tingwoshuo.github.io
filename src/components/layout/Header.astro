---
import { Search, Sun, Moon, Menu, X } from '@lucide/astro';
import { navigation } from '@/config/navigation';
import { site } from '@/config/site';
import { theme } from '@/config/theme';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href + '/'));
---
<a class="skip-link" href="#main">跳到正文</a>
<header class="site-header">
  <div class="nav-shell container">
    <a class="brand" href="/" aria-label={`${site.name}首页`}>
      <img src="/brand/mark.svg" alt="" width="32" height="32" />
      <span>{site.name}<small>{site.englishName}</small></span>
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      {navigation.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="nav-actions">
      <button class="icon-button" aria-label="搜索文章" data-search-open><Search size={18} /></button>
      <button class="icon-button theme-toggle" aria-label="深色模式" aria-pressed="false" data-theme-toggle>
        <Sun class="sun-icon" size={18} /><Moon class="moon-icon" size={18} />
      </button>
      <button class="icon-button menu-trigger" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
        <Menu class="menu-icon" size={20} /><X class="close-icon" size={20} />
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="移动导航" hidden>
    <div class="container mobile-links">
      {navigation.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </div>
  </nav>
</header>

<dialog class="search-dialog" aria-labelledby="search-title" data-search-dialog>
  <div class="search-top">
    <h2 id="search-title">搜索文章</h2>
    <button class="icon-button" aria-label="关闭搜索" data-search-close><X size={18} /></button>
  </div>
  <label class="search-field">
    <Search size={18} />
    <span class="sr-only">搜索关键词</span>
    <input data-search-input type="search" placeholder="例如 TypeScript 或日常" autocomplete="off" autofocus />
  </label>
  <p class="search-status" data-search-status role="status">输入关键词搜索全部文章。</p>
  <div class="quick-results" data-search-results></div>
  <a class="text-link" href="/search">打开完整搜索页面</a>
</dialog>

<style>
  .site-header { position: sticky; top: 0; z-index: 30; padding-top: env(safe-area-inset-top); background: color-mix(in srgb, var(--bg) 94%, transparent); border-bottom: 1px solid var(--line); }
  .nav-shell { min-height: var(--header-height); display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); }
  .brand { display: flex; align-items: center; gap: var(--space-8); min-height: var(--target); flex-shrink: 0; }
  .brand span { font-weight: 600; line-height: 1.1; }
  .brand small { display: block; color: var(--muted); font-size: .625rem; font-weight: 500; margin-top: var(--space-4); }
  .desktop-nav, .nav-actions { display: flex; align-items: center; gap: var(--space-4); }
  .desktop-nav a, .mobile-links a {
    display: flex;
    align-items: center;
    min-height: var(--target);
    padding-inline: var(--space-12);
    border-radius: var(--radius-control);
    color: var(--secondary);
    font-size: var(--type-small);
  }
  .desktop-nav a, .mobile-links a { transition: color var(--duration) var(--ease), background-color var(--duration) var(--ease); }
  nav a:hover { background: var(--surface-soft); }
  nav [aria-current] { color: var(--accent-strong); background: var(--accent-wash); }
  .menu-trigger, .mobile-nav { display: none; }
  :global(.menu-trigger .close-icon), :global(.menu-trigger[aria-expanded="true"] .menu-icon),
  :global(.theme-toggle .sun-icon), :global([data-theme="dark"] .theme-toggle .moon-icon) { display: none; }
  :global(.menu-trigger[aria-expanded="true"] .close-icon), :global([data-theme="dark"] .theme-toggle .sun-icon) { display: block; }
  @media (max-width: 767px) {
    .desktop-nav { display: none; }
    .menu-trigger { display: grid; }
    .mobile-nav:not([hidden]) {
      display: block;
      position: absolute;
      top: 100%;
      inset-inline: 0;
      background: var(--surface);
      border-block: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .mobile-links { display: grid; gap: var(--space-4); padding-block: var(--space-12); }
  }

  .search-dialog {
    position: fixed;
    inset: clamp(1rem, 12vh, 8rem) 0 auto;
    margin: 0 auto;
    width: min(100% - 2 * var(--page-gutter), 36rem);
    max-height: 80dvh;
    overflow: auto;
    background: var(--surface);
    color: var(--text);
    padding: var(--space-16);
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow);
  }
  .search-dialog::backdrop { background: rgb(17 21 17 / 48%); }
  .search-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-8); }
  .search-top h2 { font-size: var(--type-subsection); }
  .quick-results { display: grid; }
  .quick-results :global(a) { min-height: var(--target); padding-block: var(--space-8); border-top: 1px solid var(--line); overflow-wrap: anywhere; }
  .quick-results :global(a:hover) { color: var(--accent-strong); background: var(--accent-wash); }
  .quick-results :global(a) { padding-inline: var(--space-8); }
  .quick-results :global(p) {
    color: var(--secondary);
    font-size: var(--type-meta);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
</style>

<script define:vars={{ themeKey: theme.storageKey }}>
  const root = document.documentElement;
  const media = matchMedia('(prefers-color-scheme: dark)');
  const themeToggle = document.querySelector('[data-theme-toggle]');
  const updateTheme = (value) => {
    root.dataset.theme = value;
    document.querySelector('meta[name="theme-color"]').content = getComputedStyle(root).getPropertyValue('--bg').trim();
    themeToggle.setAttribute('aria-pressed', String(value === 'dark'));
  };
  updateTheme(root.dataset.theme || (media.matches ? 'dark' : 'light'));
  media.addEventListener('change', (event) => {
    try { if (localStorage.getItem(themeKey)) return; } catch {}
    updateTheme(event.matches ? 'dark' : 'light');
  });
  themeToggle.addEventListener('click', () => {
    const value = root.dataset.theme === 'dark' ? 'light' : 'dark';
    updateTheme(value);
    try { localStorage.setItem(themeKey, value); } catch {}
  });
</script>

<script>
  import { findArticles } from '@/lib/search-client';
  import { createHighlighter, renderExcerpt } from '@/lib/search-highlight';
  const menu = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const nav = document.getElementById('mobile-nav')!;
  const header = menu.closest('header')!;
  const setMenu = (open: boolean) => {
    nav.hidden = !open;
    menu.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
  };
  menu.addEventListener('click', () => setMenu(nav.hidden));
  document.addEventListener('click', (event) => { if (!header.contains(event.target as Node)) setMenu(false); });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !nav.hidden) { setMenu(false); menu.focus(); }
  });
  matchMedia('(min-width: 48rem)').addEventListener('change', () => setMenu(false));

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]')!;
  const open = document.querySelector<HTMLButtonElement>('[data-search-open]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
  const status = dialog.querySelector('[data-search-status]')!;
  const results = dialog.querySelector('[data-search-results]')!;
  const showSearch = () => {
    setMenu(false);
    if (!dialog.open) dialog.showModal();
  };
  open.addEventListener('click', showSearch);
  dialog.querySelector('[data-search-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (event) => {
    if (event.target !== dialog) return;
    const box = dialog.getBoundingClientRect();
    if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && dialog.open) {
      event.preventDefault();
      dialog.close();
      return;
    }
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      showSearch();
    }
  });

  let request = 0;
  input.addEventListener('input', async () => {
    const id = ++request;
    const query = input.value.trim();
    results.replaceChildren();
    status.textContent = query ? '正在搜索…' : '输入关键词搜索全部文章。';
    if (!query) return;
    try {
      const matches = await findArticles(query, 5);
      if (id !== request) return;
      status.textContent = matches.length ? '' : '没有找到相关文章。';
      const highlight = createHighlighter(query);
      for (const match of matches) {
        const link = document.createElement('a');
        link.href = match.url;
        const title = document.createElement('strong');
        title.append(highlight(match.meta.title || '未命名文章'));
        const snippet = document.createElement('p');
        snippet.append(renderExcerpt(match.excerpt, highlight));
        link.append(title, snippet);
        results.append(link);
      }
    } catch {
      if (id === request) status.textContent = '搜索索引暂不可用，请使用构建后的预览。';
    }
  });
</script>
