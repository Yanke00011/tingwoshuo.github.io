---
import { ArrowUpRight, Braces } from '@lucide/astro';
import type { Post } from '@/lib/posts';
import { dateLabel, postPath, readingMinutes } from '@/lib/posts';
import { postPresentation } from '@/lib/post-presentation';

interface Props {
  post: Post;
  compact?: boolean;
  showSection?: boolean;
  treatment?: 'lead' | 'spotlight';
}
const { post, compact = false, showSection = true, treatment } = Astro.props;
const section = post.collection === 'life' ? '闲聊' : '技术';
const { variant, image } = postPresentation(post, compact, treatment);
---
<article class:list={['post-row', variant, { compact, illustrated: image }]} data-variant={variant}>
  <a href={postPath(post)} class="post-link">
    {image && (
      <div class="post-media">
        <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
      </div>
    )}
    <div class="post-copy">
      <div class="post-meta">
        {variant === 'technical' && <Braces size={15} aria-hidden="true" />}
        {showSection && <span class:list={['post-section', post.collection]}>{section}</span>}
        <time datetime={post.data.pubDate.toISOString()}>{dateLabel(post.data.pubDate)}</time>
        <span>{readingMinutes(post.body)} 分钟阅读</span>
        {variant === 'technical' && post.data.updatedDate && (
          <span>更新于 <time datetime={post.data.updatedDate.toISOString()}>{dateLabel(post.data.updatedDate)}</time></span>
        )}
      </div>
      <h3>{post.data.title}</h3>
      {!compact && <p>{post.data.description}</p>}
      {!compact && post.data.tags.length > 0 && (
        <ul class="post-tags" aria-label="标签">
          {post.data.tags.slice(0, 3).map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      )}
    </div>
    <span class="post-arrow" aria-hidden="true"><ArrowUpRight size={18} /></span>
  </a>
</article>

<style>
  .post-row { min-width: 0; }
  .post-link {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-12);
    min-height: 100%;
    padding: var(--space-20);
    overflow-wrap: anywhere;
    border-radius: var(--radius-panel);
  }
  .text .post-link { border-bottom: 1px solid var(--line); border-radius: 0; padding-inline: var(--space-8); }
  .post-copy { min-width: 0; }
  .post-meta, .post-tags { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-8); color: var(--muted); font-size: var(--type-meta); }
  .post-section { color: var(--accent-strong); font-weight: 650; }
  .post-section.life { color: var(--life-ink); }
  h3 { font-size: var(--type-subsection); line-height: var(--leading-heading); margin-top: var(--space-8); }
  p { color: var(--secondary); margin-top: var(--space-8); }
  .post-tags { list-style: none; padding: 0; margin-top: var(--space-12); }
  .post-arrow { color: var(--accent-strong); display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid var(--line); border-radius: 50%; }
  .post-link:hover h3 { color: var(--accent-strong); }
  .post-link:hover .post-arrow { background: var(--accent-wash); }
  .post-media { border-radius: var(--radius-control); overflow: hidden; background: var(--surface-soft); }
  .post-media img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .cover .post-link, .mixed .post-link { background: var(--surface); border: 1px solid var(--line); }
  .cover .post-media, .spotlight .post-media { grid-column: 1 / -1; aspect-ratio: 2 / 1; }
  .mixed .post-link { grid-template-columns: minmax(0, .7fr) minmax(0, 1fr) auto; align-items: center; }
  .mixed .post-media { aspect-ratio: 4 / 3; }
  .spotlight .post-link {
    padding: clamp(1.25rem, 4vw, 2.75rem);
    background: radial-gradient(ellipse at bottom right, var(--life-wash), transparent 70%), var(--accent-wash);
    align-content: center;
  }
  .spotlight h3 { font-size: clamp(1.75rem, 3.8vw, 3.4rem); letter-spacing: -.035em; }
  .spotlight p { max-width: 32rem; }
  .technical .post-link {
    background: var(--surface);
    border: 1px solid var(--line);
    border-inline-start: 3px solid var(--accent);
  }
  .technical .post-media, .text .post-media { grid-column: 1 / -1; aspect-ratio: 3 / 2; width: min(100%, 11rem); }
  .compact .post-link { padding-block: var(--space-12); }
  .compact h3 { font-size: 1rem; }
  @media (width < 48rem) {
    .mixed .post-link { grid-template-columns: minmax(0, 1fr) auto; }
    .mixed .post-media { grid-column: 1 / -1; aspect-ratio: 16 / 9; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .post-link { transition: background-color var(--duration) var(--ease), box-shadow var(--duration) var(--ease); }
    .post-media img, .post-arrow { transition: transform 360ms var(--ease), background-color var(--duration) var(--ease); }
    .post-link:hover img { transform: scale(1.04); }
    .post-link:hover .post-arrow { transform: translate(2px, -2px); }
    :is(.cover, .mixed, .technical, .spotlight) .post-link:hover { box-shadow: var(--shadow); }
  }
</style>
