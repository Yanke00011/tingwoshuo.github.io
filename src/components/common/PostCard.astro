---
import { ArrowUpRight } from '@lucide/astro';
import type { Post } from '@/lib/posts';
import { dateLabel, postPath, readingMinutes } from '@/lib/posts';
interface Props { post: Post; compact?: boolean; }
const { post, compact = false } = Astro.props;
const section = post.collection === 'life' ? '闲聊' : '技术';
---
<article class:list={['post-card', { compact }]}><a href={postPath(post)} class="card-link">{post.data.cover && <div class="card-cover"><img src={post.data.cover} alt={post.data.coverAlt || ""} loading="lazy" decoding="async"/></div>}<div class="card-meta"><span class:list={['section-mark', post.collection]}>{section}</span><time datetime={post.data.pubDate.toISOString()}>{dateLabel(post.data.pubDate,{year:'numeric',month:'short',day:'numeric'})}</time><span>{readingMinutes(post.body)} 分钟</span></div><h3>{post.data.title}</h3><p class="card-description">{post.data.description}</p><div class="card-bottom"><div class="card-tags">{post.data.tags.slice(0,3).map(tag=><span class="tag">{tag}</span>)}</div><span class="card-arrow" aria-hidden="true"><ArrowUpRight size={16}/></span></div></a></article>
<style>.post-card{border:1px solid var(--line);background:var(--surface);border-radius:20px;transition:transform .25s var(--ease),box-shadow .25s var(--ease),border-color .25s;overflow:hidden}.post-card:hover{transform:translateY(-4px);box-shadow:var(--shadow);border-color:color-mix(in srgb,var(--accent) 28%,var(--line))}.card-link{display:block;padding:24px}.card-cover{margin:-24px -24px 18px;aspect-ratio:16/8;overflow:hidden;background:var(--surface-soft)}.card-cover img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s var(--ease)}.post-card:hover .card-cover img{transform:scale(1.025)}.card-meta{display:flex;align-items:center;gap:12px;color:var(--muted);font-size:.74rem}.section-mark{display:inline-flex;align-items:center;gap:6px;color:var(--accent-strong);font-weight:650}.section-mark:before{content:'';display:block;width:6px;height:6px;border-radius:50%;background:var(--accent)}.section-mark.tech:before{background:#879b8c}.post-card h3{font-size:1.23rem;letter-spacing:-.035em;line-height:1.45;margin:17px 0 8px}.card-description{font-size:.88rem;line-height:1.75;color:var(--muted);margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.card-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:22px}.card-tags{display:flex;gap:6px;flex-wrap:wrap}.card-tags .tag{font-size:.66rem;padding:4px 8px}.card-arrow{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:var(--surface-soft);color:var(--muted);transition:all .2s}.post-card:hover .card-arrow{background:var(--accent);color:#fff}.compact .card-link{padding:18px 20px}.compact .card-cover{margin:-18px -20px 14px}.compact h3{font-size:1.05rem;margin:10px 0 5px}.compact .card-bottom{margin-top:14px}</style>
